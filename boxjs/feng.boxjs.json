      "id": "WxCode",
      "name": "获取小程序code",
      "author": "@Feng",
      "descs_html": [
        "调用 YYB Go 服务 POST /wxapp/getCode 获取小程序 code，供印享星/途虎/海底捞/永旺/WPS 等脚本使用",
        "本处只填服务器地址与 token(请求头 Authorization: Bearer，对应服务端 YYB_PROTOCOL_TOKEN)",
        "app_id 由各脚本内置，账号 ref 填在各脚本自己的 boxjs 区域，本处不填 ref"
      ],
      "icons": [
        "https://raw.githubusercontent.com/FoKit/Scripts/main/images/WeChat.png",
        "https://raw.githubusercontent.com/FoKit/Scripts/main/images/WeChat.png"
      ],
      "keys": [
        "wxCode"
      ],
      "settings": [
        {
          "id": "@wxCode.open",
          "name": "开启code模式",
          "val": false,
          "type": "boolean",
          "desc": "默认关闭"
        },
        {
          "id": "@wxCode.address",
          "name": "服务器地址",
          "val": "http://192.168.2.5:8000",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "填写服务器地址, 不包含/, 如 http://192.168.2.5:8000"
        },
        {
          "id": "@wxCode.token",
          "name": "token",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "接口鉴权 token, 请求头 Authorization: Bearer <token>, 对应服务端环境变量 YYB_PROTOCOL_TOKEN"
        }
      ]
    },

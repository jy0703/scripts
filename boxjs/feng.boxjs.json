          "name": "移动云盘数据",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 5,
          "placeholder": "",
          "desc": "抓包生成的账号数组，可按需补充 deviceId"
        },
        {
          "id": "ydyp_device_id",
          "name": "全局 deviceId",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "placeholder": "",
          "desc": "可选，填写后所有账号优先使用；抓包 startSignIn / receiveV2 / infoV3 请求头 deviceId"
        },
        {
          "id": "ydyp_cache",
          "name": "deviceId/Token 缓存",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 4,
          "placeholder": "",
          "desc": "脚本自维护(对应 py 的 ydyp_device_ids.json)，清空即可让账号重新生成 deviceId 与刷新 Token"

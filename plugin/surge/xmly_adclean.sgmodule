#!name=喜马拉雅 · 去广告与推广净化
#!desc=物理级直拒喜马拉雅广告与埋点域名，并屏蔽好友页 Banner、底部会员促销引导窗、首页签到引导与专辑页促销价格卡。只阻断推广请求，不含任何业务返回体改写。
#!tag=去广告,喜马拉雅
#!homepage=https://github.com/jy0703/scripts
#!icon=https://raw.githubusercontent.com/jy0703/scripts/main/icons/xmly.png

# 写法与结构说明（2026-11-01 v1.1.0）：
# 1. 与 Loon 版 plugin/loon/xmly_adclean.lpx 同规则、同分组、同注释顺序；Surge 模块没有 [Argument] 开关机制，要关某一项直接注释掉对应行。
# 2. 规则来源为 WeiGiegie/666 xmly.js 头注释的「去广告」段，逐条对应；其中 xdcs-collector 与 ulogs.umeng.com 两条由路径级收紧为域名级 REJECT，少开两条 MITM 需求，效果只强不弱。
# 3. 上游对好友页 Banner 与促销引导窗用 reject（404）、对签到引导与促销价格卡用 reject-200，Surge 两种行为都是原生支持的，这里按上游原样保留。
# 4. 上游同文件里的 script-response-body（会员/大师课/音质/下载解锁主体）不收录，随之那一大串 IP 段 hostname 也不再需要；[MITM] 只留路径级规则真正要命中的 host（见段内注释）。本模块不解任何付费权益，会员仍需正常购买。

[Rule]
# 广告与推广位域名（DOMAIN-SUFFIX 一并覆盖 adse.wsa.ximalaya.com 等子域）
DOMAIN-SUFFIX,adse.ximalaya.com,REJECT
DOMAIN,ad.ximalaya.com,REJECT
# 实时行为数据上报（物理级阻断，省电防追踪）
DOMAIN,xdcs-collector.ximalaya.com,REJECT
# 友盟日志上报
DOMAIN,ulogs.umeng.com,REJECT

[URL Rewrite]
# 好友页运营 Banner
^https?:\/\/passport\.ximalaya\.com\/friendship-mobile\/v1\/findFriendsBanner\/show(?:[\/?].*)?$ - reject
# 各页面底部弹出的会员促销引导窗
^https?:\/\/mobile\.ximalaya\.com\/business-sale-promotion-guide-mobile-web\/popup\/info(?:[\/?].*)?$ - reject
# 首页签到引导弹窗
^https?:\/\/[^\/]*ximalaya\.com\/x-web-activity\/signIn\/getHomePageSignInInfo(?:[\/?].*)?$ - reject-200
# 专辑页限时促销价格卡
^https?:\/\/[^\/]*ximalaya\.com\/product\/promotion\/v1\/album\/price(?:[\/?].*)?$ - reject-200

[MITM]
# 后两条规则按上游写法不限定 host（mobwsa 才是这两个接口的实际域名），故 6 个 host 都要开口子
hostname = %APPEND% passport.ximalaya.com, mobile.ximalaya.com, mobwsa.ximalaya.com, www.ximalaya.com, m.ximalaya.com, x.ximalaya.com

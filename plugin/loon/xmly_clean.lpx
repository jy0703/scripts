#!name = 喜马拉雅 · 去广告与推广净化
#!desc = 物理级直拒喜马拉雅广告与埋点域名，并按开关屏蔽好友页 Banner、底部会员促销引导窗、首页签到引导与专辑页促销价格卡。只阻断推广请求，不含任何业务返回体改写。
#!author = Fengzzzz
#!tag = 去广告, 喜马拉雅
#!system = iOS,iPadOS
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/xmly.png
#!version = 1.1.0
#!date = 2026-11-01

# 写法与结构说明（2026-11-01 v1.1.0）：
# 1. 对齐 cmcc_clean 的写法：[Argument] 分组开关 + [Rule] 域名物理级直拒 + [Mitm] 只开必要口子，路径级处理走 [Rewrite] 声明式 `if ${开关} == true && ${url} ~= /re/i then reject(200)`。
# 2. 规则来源为 WeiGiegie/666 xmly.js 头注释的「去广告」段，逐条对应；其中 xdcs-collector 与 ulogs.umeng.com 两条由路径级收紧为域名级 REJECT，少开两条 MITM 需求，效果只强不弱。
# 3. 上游对好友页 Banner 与促销引导窗用的是硬 reject（404），本插件统一降为 reject(200) 空响应：`reject(404)` 这一形式在本仓无先例，不写没验证过的语法。若真机上这两处留下空白占位而非直接消失，改回 [Rule] 里的 URL-Regex 直拒即可。
# 4. 上游同文件里的 script-response-body（会员/大师课/音质/下载解锁主体）不收录，随之那一大串 IP 段 hostname 也不再需要；[Mitm] 只留路径级规则真正要命中的 host（见段内注释）。本插件不解任何付费权益，会员仍需正常购买。
# 5. 开关默认全开，关某一项只需把对应 switch 置 false，不用删行。

[Argument]
HideFriendBanner = switch,true,tag=[好友页] 隐藏运营 Banner,desc=屏蔽 friendship-mobile/v1/findFriendsBanner/show 的运营位拉取，好友页顶部 Banner 不再出现
HideSalePopup = switch,true,tag=[全局] 隐藏底部促销引导窗,desc=屏蔽 business-sale-promotion-guide-mobile-web/popup/info，即各页面底部弹出的会员购买引导
HideSignInGuide = switch,true,tag=[首页] 隐藏签到引导弹窗,desc=屏蔽 x-web-activity/signIn/getHomePageSignInInfo 的首页签到引导弹窗；不影响签到本身能否成功，仅不再弹引导
HideAlbumPrice = switch,true,tag=[专辑页] 隐藏促销价格卡,desc=屏蔽 product/promotion/v1/album/price，专辑页不再拉取限时促销价格卡片；正常购买入口不受影响
Vip = switch,true,tag=[Vip] Vip解锁

[Rule]
# 广告与推广位域名（DOMAIN-SUFFIX 一并覆盖 adse.wsa.ximalaya.com 等子域）
DOMAIN-SUFFIX, adse.ximalaya.com, REJECT
DOMAIN, ad.ximalaya.com, REJECT
# 实时行为数据上报（物理级阻断，省电防追踪）
DOMAIN, xdcs-collector.ximalaya.com, REJECT
# 友盟日志上报
DOMAIN, ulogs.umeng.com, REJECT

[Rewrite]
# 好友页运营 Banner
request if ${HideFriendBanner} == true && ${url} ~= /^https?:\/\/passport\.ximalaya\.com\/friendship-mobile\/v1\/findFriendsBanner\/show(?:[\/?].*)?$/i then reject(200)
# 各页面底部弹出的会员促销引导窗
request if ${HideSalePopup} == true && ${url} ~= /^https?:\/\/mobile\.ximalaya\.com\/business-sale-promotion-guide-mobile-web\/popup\/info(?:[\/?].*)?$/i then reject(200)
# 首页签到引导弹窗
request if ${HideSignInGuide} == true && ${url} ~= /^https?:\/\/[^\/]*ximalaya\.com\/x-web-activity\/signIn\/getHomePageSignInInfo(?:[\/?].*)?$/i then reject(200)
# 专辑页限时促销价格卡
request if ${HideAlbumPrice} == true && ${url} ~= /^https?:\/\/[^\/]*ximalaya\.com\/product\/promotion\/v1\/album\/price(?:[\/?].*)?$/i then reject(200)
# 喜马拉雅+会员解锁+大师课+音质/音效/下载/播放器皮肤
response if ${Vip} == true && ${url} ~= /^https?:\/\/.+((ximalaya)|(xmcdn)).+(mobile-user\/v2\/homePage|product\/detail\/v1|v1\/album\/track\/ts|mobile-playpage\/track\/v4\/baseInfo\/ts|mobile-playpage\/playpage\/tabs\/v2|mobile-playpage\/playpage\/track\/qualityAndEffect|mobile\/download\/v2\/track|mobile-user-grade\/decoratorV2\/decorationDetails\/page|mobile-album\/album\/plant\/grass)?$/i then script("https://raw.githubusercontent.com/WeiGiegie/666/refs/heads/main/xmly.js", {${Vip}}) with tag="喜马拉雅+会员解锁+大师课+音质/音效/下载/播放器皮肤", timeout=10, requires_body=true

[Mitm]
hostname = mobwsa.ximalaya.com, mobile.ximalaya.com, apisg.himalaya.com, 36.150.215.*, 61.172.194.*, 180.153.*.*, 180.153.255.*, 180.153.140.*, 180.153.250.*, 114.80.99.*, 114.80.139.2*, 61.162.174.*, 119.188.123.*, 59.83.227.*, 114.80.161.29, 1.62.62.64, 1.194.255.171, 23.236.99.89, 36.99.200.135, 42.81.4.198, 42.81.26.128, 42.81.120.58, 43.152.24.12, 43.152.24.18, 43.152.25.127, 43.152.29.38, 43.175.16.34, 43.175.22.25, 43.175.44.15, 49.7.69.197, 49.51.224.95, 101.33.11.32, 101.33.11.106, 101.33.20.34, 101.33.29.110, 103.105.60.99, 140.249.84.135, 140.249.85.189, 150.109.90.80, 150.109.91.35, 150.138.47.94, 150.138.136.145, 203.205.13*.*, 203.205.250.*, 211.152.137.*, 47.100.227.85, 61.164.145.12, 106.41.204.126, 118.25.119.177, 223.111.231.198, 120.22*.2*.*, 43.132.8*.*, 101.33.27.*, 43.141.11.*, 117.34.49.212, 36.103.197.65, 198.18.1*.*, 198.18.2*.*, 101.91.13*, 36.42.77.*, 118.180.43.252, 49.119.120.*, 58.144.235.61, 58.251.62*, 221.204.4*.*, 112.84.131.*, 112.80.180.72, 112.98.170.228, 112.99.146.108, 116.136.188.184, 116.162.203.111, 116.177.225.247, 123.138.8.*, 183.204.35.*, 183.201.114.*, 101.91.135.*, 101.91.133.*, 101.91.134.*, adse.ximalaya.com, 61.170.88.*, 42.56.64.*, *.xmcdn.com, *.ximalaya.com, 101.89.53.*, 36.131.221.*, 111.42.194.*, 111.6.56.*, 111.6.56.228, 120.232.165.228, 43.159.71.*, ulogs.umeng.com, www.taobao.com, 43.132.81.*, 114*0.*, 61.172.1*.*, 114.80.99.86, *.mysteel.*, 61.172.194.196, *xima*, *xmcdn*, 114.80.139.237, 51*.com, 43.132.80.77, 43.132.83.175, 43.132.84.11, 114.80.99.90, 114.80.99.70, 114.80.99.71, 114.80.99.89, 114.80.99.91, 114.80.99.88, 114.80.99.87, 203.205.136.87, 203.205.136.100, 203.205.136.102, 203.205.136.159, 203.205.137.27, 203.205.137.87, 203.205.137.241, 203.205.250.111, 203.205.250.113, 211.152.137.25, passport.ximalaya.com, m.ximalaya.com, 116.153.*.*, 39.156.8.*, 183.204.64.*, 61.241.178.*, 112.64.213.*, 43.174.54.*, 27.152.187.*, 117.161.*.*
<script>$(".yyzz").click(function(){$(".yztc").addClass("show")
})
$(".yztc .out").click(function(){$(".yztc").removeClass("show")
})
$(".banner").click(function(){$(this).addClass("hid")
})
$('html, body').animate({scrollTop:0 },10);var scroll =true
$(window).on('scroll',function() {var scrollTop =$(this).scrollTop();var bannerTop =$(".banner1").offset().top + 20;if (scrollTop >=bannerTop &&scroll) {$(".in_tc").removeClass("hid");$("html").removeClass("act");$(".header").removeClass("hid");$(".banner1").addClass("show");scroll=false
 }
});$(".banner video").on("ended",function() {$(".banner").addClass("hid")
 
 });$(".in_tc .con .btns .btn1").click(function(){$(".in_tc").addClass("hid")
$("html").removeClass("act")
})
$(".in_tc .con .btns .btn2").click(function(){$(".in_tc").addClass("hid")
$(".fan_tc3").addClass("show")
$("html").removeClass("act")
})
$(".fan_tc .con .out").click(function(){$(".fan_tc").removeClass("show")
})
var wwwx =$(window).width()
if(wwwx<1024){$("html").removeClass("act")
$(".in_tc").removeClass("hid")
$(".header").removeClass("hid")
$(".banner1").addClass("show")
}else{$(".i_part1 .num_box .item").each(function(index,el) {document.addEventListener("scroll",function(e) {let a =document.documentElement.scrollTop + window.innerHeight*0.2 - $(".i_part1").offset().top ;if (a >0) {$(el)
.find(".num")
.leoTextAnimate("reload",{delay:500,autorun:true,fixed:[",",":",".","-","~"," "],start:"0",});}
});});}
$(function(){var hz =$(window).height()
$(window).scroll(function() {var wz =$(window).width();if(wz >1024){var top1 =$(window).scrollTop() - $(".i_part1").offset().top - hz*1.5
 var top11 =$(window).scrollTop() - $(".i_part1").offset().top
var top111 =$(window).scrollTop() - $(".i_part1 .con2 .pics").offset().top
if(top11>0){$(".i_part1 .bj").css("opacity",top11*0.005)
}
if (top1 >0) {$(".i_part1 .con2").addClass("show")
} else {$(".i_part1 .con2").removeClass("show")
Swiper1.slideTo(0)
}
if(top111>-10 &&top111<10){$(".i_part1 .con2").addClass("show1")
}else{$(".i_part1 .con2").removeClass("show1")
}
var top4 =$(window).scrollTop() - $(".i_part4").offset().top + hz*0.5
if(top4>0){$('.t-top').css('top',-(top4 *1) + 'px')
$('.t-bottom').css('top',-(top4 *2) + 'px')
}
var top5 =$(window).scrollTop() - $(".i_part5").offset().top + hz*0.9
if(top5>0 &&(100 - top5*0.1)>0){$(".i_part5 .after").css("border-radius",(100 - top5*0.1) +"%" +(100 - top5*0.1)+"% 0 0")
}else if((100 - top5*0.1)<0){$(".i_part5 .after").css("border-radius",(0) +"%" +(0)+"% 0 0")
} 
}
})
var banner1 =new Swiper('.banner1',{speed:1000,slidesPerView:1,on:{slideChangeTransitionStart:function(swiper){var x =this.activeIndex
},},})
var Swiper1 =new Swiper('.i_part1 .con2 .i_part2 .picx',{direction:'vertical',speed:1000,slidesPerView:1,mousewheel:{releaseOnEdges:true,},on:{slideChangeTransitionStart:function(swiper){var x =this.activeIndex
$(".i_part1 .con2 .i_part2 .listx .li").eq(x).addClass("on").siblings().removeClass("on")
$(".i_part1 .con2 .i_part2 .card_box .card").eq(x).addClass("on").siblings().removeClass("on")
},},})
$(".i_part1 .con2 .i_part2 .listx .li").click(function(){var index =$(this).index()
$(this).addClass("on").siblings().removeClass("on")
$(".i_part1 .con2 .i_part2 .card_box .card").eq(index).addClass("on").siblings().removeClass("on")
Swiper1.slideTo(index)
})
$(".i_part3 .con .txts .txt").click(function(){var index =$(this).index()
if($(this).hasClass("on")){$(this).removeClass("on")
$(this).find(".txt1").stop().slideUp()
 }else{$(this).addClass("on").siblings().removeClass("on")
$(this).find(".txt1").stop().slideDown()
$(this).siblings().find(".txt1").stop().slideUp()
$(".i_part3 .con .pics .pic").eq(index).addClass("on").siblings().removeClass("on")
}
})
var swiper_part1_3 =new Swiper('.i_part1 .con3 .swiper',{autoplay:{waitForTransition:false,},loop:true,loopedSlides:5,effect:'fade',speed:1000,observer:true,observeParents:true,pagination:{el:".i_part1 .con3 .swiper .swiper-pagination",clickable:true,},on:{slideChangeTransitionStart:function() {$('.i_part1 .con3 .switch a').eq(this.activeIndex).addClass('act').siblings().removeClass('act');}
}
});var Swiper4_1 =new Swiper('.i_part4 .swiper1',{loop:true,loopedSlides:5,direction:'horizontal',speed:8000,slidesPerView:2.5,spaceBetween:'1.4%',noSwiping:true,autoplay :{delay:1,disableOnInteraction:false,},observer:true,observeParents:true,breakpoints:{1025:{slidesPerView:2.7,spaceBetween:32,direction:'vertical',}
}
})
var Swiper4_2 =new Swiper('.i_part4 .swiper2',{loop:true,loopedSlides:5,slidesPerView:2.5,spaceBetween:'1.4%',direction:'horizontal',speed:8000,noSwiping:true,autoplay :{delay:1,disableOnInteraction:false,reverse:true,},observer:true,observeParents:true,breakpoints:{1025:{slidesPerView:2.7,spaceBetween:32,direction:'vertical',}
}
})
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 })

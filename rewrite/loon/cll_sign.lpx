#!name = 车来了签到
#!desc = 自动抓取车来了签到参数，并每日定时签到，支持多账号（打开车来了 APP：首页 - 签到领福利，进入签到页触发抓取）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/cll.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获签到参数,desc=打开后按说明操作自动抓取签到参数，抓取完成后建议关闭
cronExpression = input,"0 1 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/web\.chelaile\.net\.cn\/api\/op-activity-api\/daily-act\/signin script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cll_sign.js,requires-body=false,timeout=600,tag=车来了获取签到参数,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cll_sign.js,timeout=600,tag=车来了签到,enable=true

[Mitm]
hostname = web.chelaile.net.cn

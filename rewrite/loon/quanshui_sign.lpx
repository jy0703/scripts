#!name = 泉水签到
#!desc = 自动抓取泉站订水 Token，并每日定时签到（打开泉站订水小程序自动获取）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获 Token,desc=打开后进入泉站订水小程序自动抓取 Token，抓取完成后建议关闭
cronExpression = input,"0 8 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/java-uapi\.quanzhan888\.com\/u\/user-center\/index script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/quanshui_sign.js,requires-body=true,timeout=30,tag=泉水签到获取Token,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/quanshui_sign.js,timeout=600,tag=泉水签到,enable=true

[Mitm]
hostname = java-uapi.quanzhan888.com

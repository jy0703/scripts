#!name = AgentRouter签到
#!desc = AgentRouter(agentrouter.org) 每日签到领额度，账号在 boxjs「AgentRouter签到」里填「邮箱#密码」，支持多账号
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/agentrouter.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 9 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/agentrouter_sign.js,timeout=600,tag=AgentRouter签到,enable=true

#!name = OPPO会员中心签到
#!desc = OPPO小程序会员每日积分签到，账号通过 Code Server 服务获取，支持多账号（活动 id 每次运行自动发现，token 缓存失效自动重新登录）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/oppo.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 9 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/oppo_sign.js,timeout=600,tag=OPPO会员中心签到,enable=true

#!name = 柠季签到
#!desc = 柠季柠檬茶专门店小程序每日签到领积分，账号通过 Code Server 服务获取，支持多账号
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/nj.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 9 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/nj_sign.js,timeout=600,tag=柠季签到,enable=true

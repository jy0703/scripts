#!name = 中国移动签到
#!desc = 自动抓取中国移动 App 签到凭证，并每日定时签到、领取连签奖励（boxjs 可选开启 AI豆任务、AI豆兑换话费券、秒杀抢券、追剧领福利含视频每日任务、周六游戏中心(挣游戏币，周六 12 点后抽)、幸运三日签(代每日累签，有次数时代抽，抽奖参数走取凭证网关的 wasm，抽奖口另要「捕获抽奖身份」抓一次 gr-risk-p3 令牌 + 权益市场整套设备 cookie)、AI豆苗养成记（凭证复用签到抓到的 token，不需额外抓取）、周三充值日拼图/场次秒杀），支持多账号（打开中国移动 App：登录 -「我」-「签到」进入签到领流量活动页；票据服务另开「捕获 autoLogin」抓传参）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/cmcc.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获 Cookie,desc=打开后进一次签到页抓签到凭证（豆苗凭证复用其中的 token），抓完建议关闭
captureAutoLogin = switch,false,tag=捕获 autoLogin,desc=打开后进一次中国移动 App(自动登录)抓 autoLogin 传参存进 cmcc_autologin_data，抓完建议关闭
captureRiskP3 = switch,false,tag=捕获抽奖身份,desc=打开后进一次「权益市场/幸运三日签」页面，抓两样抽奖口要的东西：① ZWRisk 决策引擎回的令牌 gr-risk-p3（和同接口的 _zw_kvani5r）→ cmcc_lucky3_risk_p3 / cmcc_lucky3_zw；② 请求头里那一整套设备 cookie（_zw+User-Token+页面态 gdp_*）→ cmcc_lucky3_jar。都是设备级、能撑几天（观测 ≥34 小时），抓完建议关闭
cronExpression = input,"58 0,7,11 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/wx\.10086\.cn\/qwhdsso\/appTokenLogin script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,requires-body=true,timeout=600,tag=中国移动获取Cookie,enable={capture}
http-request ^https?:\/\/client\.app\.coc\.10086\.cn\/.*uamrandcodelogin\/autoLogin script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,requires-body=true,timeout=60,tag=中国移动抓autoLogin传参,enable={captureAutoLogin}
http-response ^https?:\/\/yxfk\.market\.chinamobile\.com:8081\/mgt\/decision-engine\/udid\/c1 script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,requires-body=true,timeout=60,tag=中国移动抓风控令牌,enable={captureRiskP3}
http-request ^https?:\/\/dev\.coc\.10086\.cn\/coc3\/(gr|coc3-market[^/]*|gateway-route)\/ script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,requires-body=false,timeout=60,tag=中国移动抓权益市场Cookie,enable={captureRiskP3}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,timeout=600,tag=中国移动签到,enable=true

[Mitm]
hostname = wx.10086.cn, client.app.coc.10086.cn, yxfk.market.chinamobile.com, dev.coc.10086.cn

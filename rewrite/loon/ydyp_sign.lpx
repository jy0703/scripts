#!name = 移动云盘签到
#!desc = 自动抓取移动云盘 Authorization，并每日定时完成签到、云朵中心任务、算力大作战、红包派对（打开 App 首页即抓到，deviceId 可选、需自行抓包填写）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/ydyp.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获 Token,desc=打开后进入移动云盘 App 首页自动抓取 Authorization，抓取完成后建议关闭
cronExpression = input,"0 8 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/user-njs\.yun\.139\.com\/user\/ script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/ydyp.js,timeout=600,tag=移动云盘签到获取Token,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/ydyp.js,timeout=600,tag=移动云盘签到,enable=true

[Mitm]
hostname = user-njs.yun.139.com

#!name = PingMe签到
#!desc = 自动抓取 PingMe 签到参数，并定时签到、领取视频奖励（打开 PingMe App 自动获取）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/pingme.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获签到参数,desc=打开后进入 PingMe App 自动抓取参数，抓取完成后建议关闭
cronExpression = input,"30 8,20 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/api\.pingmeapp\.net\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/pingme_sign.js,requires-body=false,timeout=600,tag=PingMe获取签到参数,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/pingme_sign.js,timeout=600,tag=PingMe签到,enable=true

[Mitm]
hostname = api.pingmeapp.net

#!name = 企迈合集签到
#!desc = 企迈系列多品牌合集签到，默认内置林里与茉莉奶白、可在 boxjs 用 MILK_TEA_BRANDS 追加任意企迈小程序，账号通过 Code Server 服务获取，支持多账号（token 失效自动重新登录）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/milk_tea.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获品牌,desc=打开后逛任意企迈小程序完成一次登录即自动收录 storeId+appid 到 MILK_TEA_BRANDS，收录完建议关闭
cronExpression = input,"0 1 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-response ^https?:\/\/webapi\.qmai\.cn\/web\/account-center\/oauth\/mini-app-login script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/milk_tea_sign.js,requires-body=true,timeout=60,tag=奶茶品牌收录,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/milk_tea_sign.js,timeout=600,tag=企迈合集签到,enable=true

[Mitm]
hostname = webapi.qmai.cn

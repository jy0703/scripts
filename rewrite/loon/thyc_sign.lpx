#!name = 途虎养车签到
#!desc = 途虎养车小程序每日签到领积分，账号通过 Code Server 服务获取，支持多账号
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/thyc.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"24 8 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/thyc_sign.js,timeout=600,tag=途虎养车签到,enable=true

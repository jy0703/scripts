#!name = 阿里云社区签到
#!desc = 自动抓取阿里云开发者社区 Cookie，并每日定时签到、达标抽奖、文章互动、问答点赞、电子书评价，支持多账号（浏览器登录 developer.aliyun.com 后打开 个人中心 或 积分商城 页面触发抓取）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/aliyun.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获Cookie,desc=打开后按说明操作自动抓取，抓取完成后建议关闭
cronExpression = input,"0 7,13 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/developer\.aliyun\.com\/developer\/api\/(my\/user\/getUser|my\/score\/getUserScore|sign\/getSpaceSignInInfo) script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/aliyun_sign.js,requires-body=false,timeout=600,tag=阿里云社区获取Cookie,enable={capture}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/aliyun_sign.js,timeout=600,tag=阿里云社区签到,enable=true

[Mitm]
hostname = developer.aliyun.com

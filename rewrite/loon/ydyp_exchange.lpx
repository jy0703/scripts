#!name = 移动云盘商品抢兑
#!desc = 云朵中心按商品ID抢兑奖品（每日 10:00/16:00/00:00），账号通过 Code Server 服务获取，支持多账号
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/ydyp.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 10,16,0 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/ydyp_exchange.js,timeout=600,tag=移动云盘商品抢兑,enable=true

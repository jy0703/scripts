#!name = QQ经典农场获取code
#!desc = 打开 QQ/微信小程序「QQ经典农场」，自动捕获登录 code 并通知
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!tag = 辅助,游戏
#!type = normal

[Argument]
capture = switch,false,tag=捕获 code,desc=打开后进入游戏自动捕获 code，捕获后建议关闭

[Script]
http-request ^https?:\/\/gate-obt\.nqf\.qq\.com\/prod\/ws\? script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/get_farm_code.js,requires-body=false,timeout=30,tag=QQ经典农场获取code,enable={capture}

[Mitm]
hostname = gate-obt.nqf.qq.com

#!name = 夸克网盘签到
#!desc = 夸克网盘每日签到领空间容量，支持多账号：BoxJS 只有 quark_data 一个入口，把取凭证网页（quark-api/）「复制 全部账号（票+UA）」的 JSON 粘进去即可；填 quark_api 后每次运行自动向服务换票并写回缓存，UA 跟随账号
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/quark.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 9 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/quark_sign.js,timeout=600,tag=夸克网盘签到,enable=true

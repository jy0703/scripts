#!name = 永旺签到
#!desc = 永旺小程序每日签到领积分，账号通过 Code Server 服务获取，支持多账号（token 约 28 天有效，失效自动重新登录）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/aeon.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"10 8 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/aeon_sign.js,timeout=600,tag=永旺签到,enable=true

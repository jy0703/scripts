#!name = 龙湖天街签到
#!desc = 自动抓取龙湖天街 Cookie，并每日定时签到、抽奖，支持多账号（打开龙湖天街小程序：我的 - 签到赚珑珠 - 任务赚奖励 - 马上签到；换期后另开「捕获抽奖ID」进一次 App 抽奖页，或等定时任务读签到回包自动刷新）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/lhtj.png
#!tag = 签到,自动化
#!type = normal

[Argument]
capture = switch,false,tag=捕获 Cookie,desc=打开后按说明操作自动抓取 Cookie，抓取完成后建议关闭
captureLottery = switch,false,tag=捕获抽奖ID,desc=打开后在 App 里进一次抽奖页，自动把当期组件ID写进 boxjs 的 lhtj_lottery_app，抓完建议关闭（定时任务的签到回包也会自动刷新，不用常开）
cronExpression = input,"0 1 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数

[Script]
http-request ^https?:\/\/gw2c\-hw\-open\.longfor\.com\/lmarketing\-task\-api\-mvc\-prod\/openapi\/task\/v1\/signature\/clock script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/lhtj.js,requires-body=false,timeout=600,tag=龙湖天街获取Cookie,enable={capture}
http-request ^https?:\/\/gw2c\-hw\-open\.longfor\.com\/llt\-gateway\-prod\/api\/v1\/activity\/auth\/lottery\/(sign|chance|click) script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/lhtj.js,requires-body=true,timeout=600,tag=龙湖天街获取抽奖ID,enable={captureLottery}
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/lhtj.js,timeout=600,tag=龙湖天街签到,enable=true

[Mitm]
hostname = gw2c-hw-open.longfor.com

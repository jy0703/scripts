#!name = 咪咕音乐签到
#!desc = 咪咕音乐 AI 豆中心每日签到、社区入口、听歌计时上报与档位领奖，支持多账号（手机号+密码登录，自动换 ce 并缓存；评论/彩铃默认关闭）
#!author = Fengzzzz
#!homepage = https://github.com/jy0703/scripts
#!icon = https://raw.githubusercontent.com/jy0703/scripts/main/icons/migu.png
#!tag = 签到,自动化
#!type = normal

[Argument]
cronExpression = input,"0 8 * * *",tag=定时参数,desc=这里需要输入符合 CRON 表达式的参数（听歌跑满约 30 分钟，建议夜间触发）

[Script]
cron {cronExpression} script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/migu_sign.js,timeout=3600,tag=咪咕音乐签到,enable=true

#!name=GLaDOS获取Cookie
#!desc=自动抓取GLaDOS/Railgun Cookie
#!打开浏览器访问 https://glados.network/console/account 或 https://railgun.info/console/account 或 https://glados.vip/console/account 登录后即可自动获取Cookie。

[Script]
GLaDOS获取Cookie= type=http-request ^https?:\/\/(glados\.network|railgun\.info|glados\.vip)\/console\/account, requires-body=0, max-size=0, timeout=600, script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/glados.js, script-update-interval=0

[MITM]
hostname = %APPEND% glados.network, railgun.info, glados.vip
#!name=中国移动获取Cookie
#!desc=自动抓取中国移动签到凭证
#!打开中国移动 App，进入 登录 -「我」-「签到」签到领流量/话费 活动页。
#!开了 boxjs「AI豆苗养成记」的，再进一次「AI豆苗养成记」活动页，自动抓 phone 头写进 cmcc_data 的 coc3Phone。

[Script]
中国移动获取Cookie = type=http-request,pattern=^https?:\/\/wx\.10086\.cn\/qwhdsso\/appTokenLogin,requires-body=1,max-size=0,timeout=600,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,script-update-interval=0
中国移动豆苗获取phone = type=http-request,pattern=^https?:\/\/dev\.coc\.10086\.cn\/,max-size=0,timeout=600,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,script-update-interval=0

[MITM]
hostname = %APPEND% wx.10086.cn,dev.coc.10086.cn

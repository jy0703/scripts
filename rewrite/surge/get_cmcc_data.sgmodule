#!name=中国移动获取Cookie
#!desc=自动抓取中国移动签到凭证与 autoLogin 传参
#!打开中国移动 App，进入 登录 -「我」-「签到」签到领流量/话费 活动页抓凭证；要喂票据服务就再触发一次自动登录抓 autoLogin 传参。

[Script]
中国移动获取Cookie = type=http-request,pattern=^https?:\/\/wx\.10086\.cn\/qwhdsso\/appTokenLogin,requires-body=1,max-size=0,timeout=600,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,script-update-interval=0
中国移动抓autoLogin传参 = type=http-request,pattern=^https?:\/\/client\.app\.coc\.10086\.cn\/.*uamrandcodelogin\/autoLogin,requires-body=1,max-size=0,timeout=60,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sign.js,script-update-interval=0

[MITM]
hostname = %APPEND% wx.10086.cn, client.app.coc.10086.cn

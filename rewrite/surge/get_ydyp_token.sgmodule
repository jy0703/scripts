#!name=移动云盘获取Token
#!desc=自动抓取移动云盘 Authorization/手机号
#!打开移动云盘 App，进入 活动 - 云朵中心（或任意活动页）触发抓取；deviceId 可在 BoxJS 的 ydyp_device_id 里补填（抓包 startSignIn / receiveV2 / infoV3 请求头 deviceId）。

[Script]
移动云盘获取Token= type=http-request ^https?:\/\/h\.139\.com\/ccopapi\/share\/share5gMessage, requires-body=1, max-size=0, timeout=600, binary-body-mode=0, script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/ydyp.js, script-update-interval=0

[MITM]
hostname = %APPEND% h.139.com

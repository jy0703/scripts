#!name=中国移动抓活动参数
#!desc=抓取「每日登录活动」的当期参数（抽奖/打卡 activityId、pageId、channelId、七日金额表）写入 cmcc_sevenday_prize_cfg，供「移动七日夺宝」与取凭证网关使用；活动改期后重抓一次即可
#!进入 App「每日登录活动」页（七日打卡分百万 / 天天来夺宝）即触发；抓到的参数存进 boxjs 的 cmcc_sevenday_prize_cfg，与脚本内置默认值相同的项不会写入

[Script]
中国移动抓活动参数 = type=http-request,pattern=^https?:\/\/dev\.coc\.10086\.cn\/coc\/(web6\/dailyLoginEvent(?!\/assets)|activities\/prize\/(drawDayNum|consecutiveClockInQuery)),requires-body=1,max-size=0,timeout=60,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sevenday_prize.js,script-update-interval=0
中国移动抓七日金额 = type=http-response,pattern=^https?:\/\/dev\.coc\.10086\.cn\/coc\/web6\/dailyLoginEvent\/assets\/index-,requires-body=1,max-size=2097152,timeout=60,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/cmcc_sevenday_prize.js,script-update-interval=0

[MITM]
hostname = %APPEND% dev.coc.10086.cn

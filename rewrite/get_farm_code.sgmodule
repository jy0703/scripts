#!name=NQF Code Capture
#!desc=Auto capture code from NQF ws request
#!Open the target page, trigger the ws request, and the script will notify the code.

[Script]
NQF Code Capture = type=http-request,pattern=https:\/\/gate-obt\.nqf\.qq\.com\/prod\/ws\?,requires-body=0,max-size=0,timeout=30,script-path=https://raw.githubusercontent.com/jy0703/scripts/main/scripts/nqf_get_code.js,script-update-interval=0

[MITM]
hostname = %APPEND% gate-obt.nqf.qq.com
